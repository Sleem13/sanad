{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PROVISIONAL owner schema (placeholder - replace with Ministry-supplied Schema)",
  "$comment": "provisional-0",
  "type": "object",
  "required": ["document_id", "source_sha256", "page_count", "pages"],
  "properties": {
    "document_id": {"type": "string", "minLength": 1},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "page_count": {"type": "integer", "minimum": 1},
    "pages": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "required": ["page_no", "approved_version_id", "text", "regions"],
                "properties": {"page_no": {"type": "integer", "minimum": 1}, "text": {"type": "string"}}}
    }
  }
}
